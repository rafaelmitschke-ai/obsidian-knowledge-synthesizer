{
  "name": "aetheris-root",
  "version": "1.0.0",
  "description": "Obsidian Knowledge Synthesizer Root Workspace",
  "private": true,
  "main": "main.js",
  "type": "module",
  "scripts": {
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend",
    "install:all": "npm install && npm run install:backend && npm run install:frontend",
    "dev": "concurrently \"npm run start --prefix backend\" \"npm run dev --prefix frontend\"",
    "desktop": "cross-env NODE_ENV=development concurrently \"npm run dev\" \"electron .\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "electron": "^43.0.0"
  }
}
